{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investimaker.invalid/schemas/character.schema.json",
  "title": "InvestiMaker Character v1",
  "description": "InvestiMaker_Character_Schema_v1.md の構造部分。instanceId の重複と appearance.body の参照先は Schema では表せないため、実装の検証器（src/core/character/validate.ts）が確かめる。未知のフィールドは許可する（読み込んだ実装はそのまま保持する）。",
  "type": "object",
  "required": ["format", "formatVersion", "id", "name", "appearance", "sharedColors", "equipment", "state"],
  "properties": {
    "format": { "const": "INVESTIMAKER_CHARACTER" },
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "name": { "type": "string", "maxLength": 200 },
    "appearance": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": { "$ref": "#/$defs/uuid", "description": "素体の Equipment Instance の instanceId" },
        "fit": { "$ref": "#/$defs/idMap" }
      }
    },
    "sharedColors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "equipment": {
      "type": "array",
      "items": { "$ref": "#/$defs/equipmentInstance" }
    },
    "state": {
      "type": "object",
      "required": ["view", "pose", "expression"],
      "properties": {
        "view": { "$ref": "#/$defs/id" },
        "pose": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "properties": {
            "torso": { "$ref": "#/$defs/id" },
            "arm.left": { "$ref": "#/$defs/id" },
            "arm.right": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": { "$ref": "#/$defs/id" },
          "required": ["torso", "arm.left", "arm.right"]
        },
        "expression": {
          "type": "object",
          "required": ["eyes", "eyebrows", "mouth"],
          "properties": {
            "eyes": { "$ref": "#/$defs/id" },
            "eyebrows": { "$ref": "#/$defs/id" },
            "mouth": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "composition": { "type": "object", "description": "予約。v1 は中身を解釈せず保持する" },
    "requirements": { "description": "State と Equipment から導出するキャッシュ。形が崩れていても Character は不正にならない" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "id": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
    "partId": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "idMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "equipmentInstance": {
      "type": "object",
      "required": ["instanceId", "partId", "equipped"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/uuid" },
        "partId": { "$ref": "#/$defs/partId" },
        "equipped": { "type": "boolean" },
        "colors": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "linked": { "type": "boolean" },
              "color": { "$ref": "#/$defs/color" }
            }
          }
        },
        "transform": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "scaleX": { "type": "number" },
            "scaleY": { "type": "number" },
            "rotation": { "type": "number" },
            "pivot": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        },
        "overrides": { "type": "object", "description": "予約。v1 は中身を解釈せず保持する" }
      }
    }
  }
}
